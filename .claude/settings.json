      "Bash(python -c ' *)",
      "Bash(rm -f \"C:/Users/enoch/AppData/Local/Temp/convert_citations.py\")",
      "Bash(grep -rn \"\\\\\\\\\\\\\\\\cite[a-z]*{\" sections/)",
      "Bash(echo \"No remaining \\\\\\\\cite commands outside native LaTeX\")"
