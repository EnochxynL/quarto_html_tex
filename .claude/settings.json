{
  "permissions": {
    "allow": [
      "__claude-auto-approve__",
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "TodoWrite(*)",
      "Task(*)",
      "NotebookEdit(*)",
      "Bash(kpsewhich markdown.sty)",
      "Bash(xelatex -shell-escape -interaction=nonstopmode -halt-on-error -jobname=main main.tex)",
      "Bash(echo \"pass1: $?\")",
      "Bash(bibtex main *)",
      "Bash(echo \"bibtex: $?\")",
      "Bash(echo \"pass2: $?\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({decision: 'approve'}))\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({decision: 'approve', answer: 'yes'}))\""
          }
        ]
      }
    ]
  }
}
