      "Bash(echo \"pass2: $?\")",
      "Read(//c/Users/enoch/AppData/Roaming/MiKTeX/tex/latex/markdown/**)",
      "Bash(python -)",
      "Bash(python \"C:/Users/enoch/AppData/Local/Temp/convert_citations.py\")",
      "Read(//c/Users/enoch/AppData/Roaming/MiKTeX/**)",
      "Read(//c/Users/enoch/AppData/Local/Programs/**)",
      "Read(//c/Users/enoch/AppData/Roaming/MiKTeX/tex/luatex/markdown/**)",
      "__claude-auto-approve__",
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "TodoWrite(*)",
      "Task(*)",
      "NotebookEdit(*)",
      "Bash(echo \"BIBTEX exit: $?\")",
