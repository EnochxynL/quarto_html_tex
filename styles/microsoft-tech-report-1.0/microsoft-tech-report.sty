\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{microsoft-tech-report}[2026/06/12 Microsoft tech report template]

% --------------------------------------------------
% Packages
% --------------------------------------------------
\RequirePackage[a4paper,top=2.2cm,bottom=2.4cm,left=2.4cm,right=2.4cm,headheight=14pt,headsep=16pt,footskip=26pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{placeins}
\RequirePackage{hyphenat}
\RequirePackage{setspace}
\RequirePackage[table]{xcolor}
\RequirePackage{tgheros}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}

% --------------------------------------------------
% Color system
% --------------------------------------------------
\definecolor{microsoftblue}{HTML}{2563EB}
\definecolor{microsoftaccent}{HTML}{F59E0B}
\definecolor{microsoftdark}{HTML}{0F172A}
\definecolor{microsoftgray}{HTML}{475569}
\definecolor{microsoftline}{HTML}{CBD5E1}
\definecolor{microsoftcard}{HTML}{F1F5F9}

% --------------------------------------------------
% Metadata
% --------------------------------------------------
\newcommand{\microsoftreportlabel}{Technical Report}
\newcommand{\microsoftreportshorttitle}{}
\newcommand{\microsoftbrandmark}{}
\newcommand{\reportlogoheight}{0.72cm}

\newcommand{\techreportlabel}[1]{\renewcommand{\microsoftreportlabel}{#1}}
\newcommand{\techreportshorttitle}[1]{\renewcommand{\microsoftreportshorttitle}{#1}}
\newcommand{\techreportbrandmark}[1]{\renewcommand{\microsoftbrandmark}{#1}}
\newcommand{\techreportlogoheight}[1]{\renewcommand{\reportlogoheight}{#1}}

% --------------------------------------------------
% Typography
% --------------------------------------------------
\newcommand{\microsoftsans}{\fontfamily{qhv}\selectfont}
\newcommand{\microsofttitlefont}{\microsoftsans\bfseries}
\newcommand{\microsoftdatefont}{\rmfamily\itshape}
\newcommand{\microsoftmetalabel}[1]{{\microsoftsans\small\bfseries\color{microsoftblue} #1:}\hspace{0.35em}}
\newcommand{\techreportmonthyear}{%
  \ifcase\month
  \or January%
  \or February%
  \or March%
  \or April%
  \or May%
  \or June%
  \or July%
  \or August%
  \or September%
  \or October%
  \or November%
  \or December%
  \fi, \number\year
}

% --------------------------------------------------
% Paragraphs and spacing
% --------------------------------------------------
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}
\linespread{1.05}

% --------------------------------------------------
% Caption style
% --------------------------------------------------
\DeclareCaptionLabelSeparator{microsoftcustom}{}
\DeclareCaptionFormat{microsoftcustom}{{\microsoftsans\textbf{#1 #2}} #3}
\captionsetup{
  singlelinecheck=false,
  format=microsoftcustom,
  labelsep=microsoftcustom,
  font=small
}

% --------------------------------------------------
% Section style
% --------------------------------------------------
\titleformat*{\section}{\Large\microsoftsans\bfseries\color{microsoftdark}}
\titleformat*{\subsection}{\large\microsoftsans\bfseries\color{microsoftdark}}
\titleformat*{\subsubsection}{\normalsize\microsoftsans\bfseries\color{microsoftdark}}

\titlespacing*{\section}{0pt}{1.2em}{0.6em}
\titlespacing*{\subsection}{0pt}{0.9em}{0.4em}
\titlespacing*{\subsubsection}{0pt}{0.7em}{0.3em}

% --------------------------------------------------
% Abstract
% --------------------------------------------------
\renewenvironment{abstract}
  {%
    \par\noindent
    \small
    \color{microsoftdark}
  }
  {%
    \par\normalsize
  }

% --------------------------------------------------
% Header and footer
% --------------------------------------------------
\fancypagestyle{firstheader}{
  \fancyhf{}
  \fancyhead[L]{\footnotesize\microsoftsans\color{microsoftgray}\microsoftreportlabel}
  \fancyhead[R]{\microsoftbrandmark}
  \renewcommand{\headrulewidth}{0.8pt}
  \renewcommand{\headrule}{\hbox to\headwidth{\color{microsoftline}\leaders\hrule height \headrulewidth\hfill}}
}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\footnotesize\microsoftsans\color{microsoftgray}\thepage}
\renewcommand{\headrulewidth}{0pt}

% --------------------------------------------------
% Title page helpers
% --------------------------------------------------
\newcommand{\techreportlogo}[1]{%
  \raisebox{-0.5\height}{\includegraphics[height=\reportlogoheight]{#1}}\hspace{0.7em}%
}

\newcommand{\techreportlogos}[1]{%
  \noindent
  \begin{minipage}[c]{0.64\linewidth}
    \raggedright
    #1%
  \end{minipage}%
}

\newcommand{\techreportdate}[1]{%
  \begin{minipage}[c]{0.35\linewidth}
    \raggedleft
    {\microsoftdatefont\small\color{microsoftgray}#1}
  \end{minipage}\par
}

\newcommand{\techreporttoprule}{%
  \vspace{0.18em}
  \noindent{\color{microsoftline}\rule{\linewidth}{0.8pt}\par}
}

\newcommand{\techreporttitle}[1]{%
  \vspace{0.42em}
  \begin{center}
    {{\microsofttitlefont\fontsize{18}{21}\selectfont\color{microsoftdark}#1\par}}
  \end{center}
}

\newcommand{\techreportauthors}[2]{%
  \begin{center}
    {\normalsize\rmfamily\color{microsoftdark}#1\par}
    \vspace{0.2em}
    {\footnotesize\rmfamily\color{microsoftgray}#2\par}
  \end{center}
}

\newtcolorbox{microsofttitlebox}{
  enhanced,
  frame hidden,
  colback=microsoftcard,
  colframe=microsoftline,
  boxrule=0.5pt,
  arc=8pt,
  left=0.34cm,
  right=0.34cm,
  top=0.28cm,
  bottom=0.28cm,
  before skip=0pt,
  after skip=1.0em,
  drop shadow={opacity=0.06}
}

\newcommand{\techreportmeta}[2]{%
  \ifblank{#2}{}{{\microsoftmetalabel{#1}#2\par}}%
}

\newcommand{\techreportplaceholder}[1]{%
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=microsoftline,
    boxrule=0.6pt,
    arc=6pt,
    height=4.2cm,
    valign=center,
    halign=center
  ]
  {\microsoftsans\small\color{microsoftgray}#1}
  \end{tcolorbox}
}

% --------------------------------------------------
% Utilities
% --------------------------------------------------
\newcommand{\highlight}[1]{\textcolor{microsoftaccent}{\textbf{#1}}}

\newcommand{\microsoftdivider}{%
  \vspace{0.6em}
  {\color{microsoftline}\hrule height 0.6pt}
  \vspace{0.6em}
}
